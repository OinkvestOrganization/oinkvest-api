// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(uuid())
  nome               String
  email              String
  senha              String
  dataCriacao        DateTime            @default(now())
  emailVerificado    DateTime?
  verificationTokens VerificationToken[]
  status Boolean @default(true)
  exchangeCredentials  ExchangeCredential[]
  walletBalances       WalletBalance[]
  walletSyncLogs       WalletSyncLog[]
}

model VerificationToken {
  id      String   @id @default(cuid())
  token   String   @unique
  expires DateTime
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Wallet and Binance Integration Models ---

model ExchangeCredential {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  exchange     String   @default("BINANCE")
  apiKey       String   // armazenar cifrado
  apiSecret    String   // armazenar cifrado
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, exchange])
}

model WalletBalance {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  asset      String
  free       Decimal  @default(0)
  locked     Decimal  @default(0)
  total      Decimal  @default(0)
  lastSyncAt DateTime @default(now())

  @@unique([userId, asset])
  @@index([asset])
}

model WalletSyncLog {
  id          String   @id @default(cuid())
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String?
  type        String   @default("SPOT_BALANCE")
  status      String   @default("PENDING") // PENDING, SUCCESS, ERROR
  message     String?  // erro ou mensagem do resultado
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  createdAt   DateTime @default(now())
}
