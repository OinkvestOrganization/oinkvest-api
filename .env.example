# .env

# Configurações do Banco de Dados PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mydatabase
DB_PORT=5432

# URL de Conexão para a Aplicação (o Docker Compose usará as variáveis acima)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:${DB_PORT}/${POSTGRES_DB}?schema=public"

# Segredos da Aplicação
JWT_SECRET=segredojwt

#SMTP VARIABLE
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="seu@email.com"
SMTP_PASSWORD="suaapikey vide tutorial criaçao de api key no gmail"
EMAIL_FROM="OinkVest <no-reply@oinkvest.com.br>"
